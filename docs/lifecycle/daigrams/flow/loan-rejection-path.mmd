flowchart TD
    Start([Loan Application Started])

    Profile["Customer Service<br/>(Profile Completed)"]
    KYC["KYC Service<br/>(Verification)"]
    Income["Income Service<br/>(Employment Check)"]
    Credit["Credit Service<br/>(Bureau Check)"]
    Eligibility["Eligibility Service<br/>(FOIR/IIR Evaluation)"]

    RejectKYC(["❌ Loan Rejected<br/>(KYC Failed)"])
    RejectIncome(["❌ Loan Rejected<br/>(Salary Below Min)"])
    RejectCredit(["❌ Loan Rejected<br/>(Credit Score Low)"])
    RejectElig(["❌ Loan Rejected<br/>(Eligibility Failed)"])

    End(["Loan Application<br/>Closed (REJECTED)"])

    Start --> Profile
    Profile --> KYC

    KYC -->|✅ Verified| Income
    KYC -->|❌ Failed| RejectKYC

    Income -->|✅ Verified| Credit
    Income -->|❌ Failed| RejectIncome

    Credit -->|✅ Verified| Eligibility
    Credit -->|❌ Failed| RejectCredit

    Eligibility -->|✅ Eligible| End
    Eligibility -->|❌ Ineligible| RejectElig

    RejectKYC --> End
    RejectIncome --> End
    RejectCredit --> End
    RejectElig --> End
