flowchart TD
    Start([Loan Application Started])

    Identity["Identity Service<br/>(OTP/Session)"]
    Profile["Customer Service<br/>(Profile)"]
    KYC["KYC Service<br/>(PAN/Aadhaar/Face)"]
    Income["Income Service<br/>(Salary Verification)"]
    Credit["Credit Service<br/>(Bureau Check)"]
    Eligibility["Eligibility Service<br/>(FOIR/IIR)"]
    Offer["Offer Service<br/>(Generate Offer)"]
    Accept["Customer Accepts<br/>Offer"]
    Sanction["Sanction Service<br/>(eSign)"]
    PayVer["Payment Verification<br/>(Bank Validation)"]
    Disb["Disbursement Service<br/>(NACH + Transfer)"]
    Collection["Collection Service<br/>(EMI Schedule)"]
    End([Loan Active])

    Start --> Identity
    Identity --> Profile
    Profile --> KYC
    KYC --> Income
    Income --> Credit
    Credit --> Eligibility
    Eligibility --> Offer
    Offer --> Accept
    Accept --> Sanction
    Sanction --> PayVer
    PayVer --> Disb
    Disb --> Collection
    Collection --> End
