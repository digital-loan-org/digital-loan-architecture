C4Container
    title Digital Loan Origination Platform - Container Diagram (FINAL - 16 Services)

    Person(customer, "Customer", "Salaried loan applicant")

    System_Boundary(loan_boundary, "Digital Loan Origination Platform") {

        Container(api_gateway, "API Gateway", "Spring Cloud Gateway", "Single entry point for customer requests, routes to services")
        
        Container(identity_service, "Identity Service", "Spring Boot", "OTP generation/verification, session management, auth tokens")
        Container(customer_service, "Customer Service", "Spring Boot", "Customer profile, de-duplication by PAN")
        Container(kyc_service, "KYC Service", "Spring Boot", "KYC workflow: PAN, Aadhaar, face match verification")
        Container(loan_service, "Loan Application Service", "Spring Boot", "Loan state machine, lifecycle ownership (ONLY state owner)")
        Container(income_service, "Income Service", "Spring Boot", "Salary verification, employment classification")
        Container(credit_service, "Credit Service", "Spring Boot", "Bureau fetch, credit interpretation, scoring")
        Container(eligibility_service, "Eligibility Service", "Spring Boot", "FOIR/IIR computation, eligibility rules")
        Container(offer_service, "Offer Service", "Spring Boot", "Eligible loan offer generation, tenure options")
        Container(sanction_service, "Sanction Service", "Spring Boot", "Sanction letter, eSign initiation")
        Container(payment_verif_service, "Payment Verification Service", "Spring Boot", "Bank account validation, IFSC verification (NEW)")
        Container(disbursement_service, "Disbursement Service", "Spring Boot", "NACH setup, fund transfer execution")
        Container(collection_service, "Collection Service", "Spring Boot", "EMI schedule, repayment tracking, delinquency")
        Container(notification_service, "Notification Service", "Spring Boot", "SMS/Email/Push notifications")
        
        Container(workflow_service, "Workflow Service", "Camunda BPMN", "Loan journey orchestration, retries, compensation (NO data storage)")
        Container(config_service, "Config Service", "Spring Boot", "Platform config, vendor toggles, retry settings (NO business logic)")
        Container(audit_service, "Audit Service", "Spring Boot", "Immutable append-only audit trail")

        ContainerDb(postgres_dbs, "Service Databases", "PostgreSQL", "Each service owns its schema (data isolation)")
        ContainerDb(camunda_db, "Camunda DB", "PostgreSQL", "Workflow engine state")
        ContainerDb(audit_db, "Audit Store", "Append-only DB", "Immutable audit logs (Cassandra)")
        Container(event_bus, "Event Bus", "Kafka", "Domain events (Transactional Outbox pattern)")
    }

    System_Ext(kyc_vendor, "KYC Vendor", "Identity verification (ULI, Karza)")
    System_Ext(bank_vendor, "Bank Aggregator", "Bank statements, salary (ULI, Ignosis)")
    System_Ext(bureau_vendor, "Credit Bureau", "Credit reports (CRIF Highmark)")
    System_Ext(esign_vendor, "eSign Provider", "Document signing (ULI, SignDesk)")
    System_Ext(nach_vendor, "NACH Provider", "Mandate setup (CAMS, Razorpay)")
    System_Ext(epfo_vendor, "EPFO", "Employment verification")
    System_Ext(notification_sys, "SMS/Email Service", "Vendor notifications")

    Rel(customer, api_gateway, "Uses (REST)")

    Rel(api_gateway, identity_service, "OTP/Auth APIs")
    Rel(api_gateway, customer_service, "Profile APIs")
    Rel(api_gateway, loan_service, "Loan status APIs")

    Rel(loan_service, workflow_service, "Starts/updates workflow")
    Rel(workflow_service, event_bus, "Publishes/consumes events")
    Rel(event_bus, kyc_service, "KYC events")
    Rel(event_bus, income_service, "Income events")
    Rel(event_bus, credit_service, "Credit events")
    Rel(event_bus, eligibility_service, "Eligibility events")
    Rel(event_bus, offer_service, "Offer events")
    Rel(event_bus, sanction_service, "Sanction events")
    Rel(event_bus, payment_verif_service, "Payment events")
    Rel(event_bus, disbursement_service, "Disbursement events")
    Rel(event_bus, collection_service, "Collection events")
    Rel(event_bus, audit_service, "All events -> Audit")
    Rel(event_bus, notification_service, "Select events -> Notifications")

    Rel(kyc_service, kyc_vendor, "Verifies identity (sdk)")
    Rel(income_service, bank_vendor, "Fetches bank data (sdk)")
    Rel(credit_service, bureau_vendor, "Fetches credit data (sdk)")
    Rel(sanction_service, esign_vendor, "Initiates eSign (sdk)")
    Rel(payment_verif_service, bank_vendor, "Validates account (sdk)")
    Rel(disbursement_service, nach_vendor, "Sets up mandate (sdk)")
    Rel(income_service, epfo_vendor, "Verifies employment (sdk)")
    Rel(notification_service, notification_sys, "Sends SMS/Email (sdk)")

    Rel(loan_service, postgres_dbs, "Persists state")
    Rel(customer_service, postgres_dbs, "Persists profiles")
    Rel(kyc_service, postgres_dbs, "Persists KYC")
    Rel(income_service, postgres_dbs, "Persists income")
    Rel(credit_service, postgres_dbs, "Persists credit")
    Rel(eligibility_service, postgres_dbs, "Persists decisions")
    Rel(offer_service, postgres_dbs, "Persists offers")
    Rel(sanction_service, postgres_dbs, "Persists sanction")
    Rel(payment_verif_service, postgres_dbs, "Persists verification")
    Rel(disbursement_service, postgres_dbs, "Persists disbursement")
    Rel(collection_service, postgres_dbs, "Persists EMI/repay")
    Rel(config_service, postgres_dbs, "Reads/writes config")
    Rel(workflow_service, camunda_db, "Workflow state")
    Rel(audit_service, audit_db, "Immutable audit logs")