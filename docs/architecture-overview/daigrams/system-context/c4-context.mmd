C4Context
    title Digital Loan Origination Platform - System Context

    Person(customer, "Customer", "Salaried individual applying for a personal loan")

    System(loan_platform, "Digital Loan Origination Platform", "End-to-end digital system handling onboarding, verification, eligibility, sanction, and disbursement")

    System_Ext(kyc_vendor, "KYC & Identity Vendor", "PAN, Aadhaar, face match, liveliness verification")
    System_Ext(bank_vendor, "Bank Aggregator", "Salary verification and bank statement analysis")
    System_Ext(bureau_vendor, "Credit Bureau", "Credit score, DPD and vintage checks")
    System_Ext(esign_vendor, "eSign Provider", "Digital signing of sanction documents")
    System_Ext(nach_vendor, "NACH Provider", "EMI mandate setup")
    System_Ext(notification_system, "Notification System", "SMS / Email / Push notifications")

    Rel(customer, loan_platform, "Applies for loan, checks status")

    Rel(loan_platform, kyc_vendor, "Performs identity verification")
    Rel(loan_platform, bank_vendor, "Fetches salary and bank data")
    Rel(loan_platform, bureau_vendor, "Fetches credit report")
    Rel(loan_platform, esign_vendor, "Initiates e-signing")
    Rel(loan_platform, nach_vendor, "Sets up NACH mandate")
    Rel(loan_platform, notification_system, "Sends notifications")